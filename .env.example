# ==============================================================================
# BankPoker Environment Configuration Template
# Copy this file to .env on the Ubuntu PC and configure your secret key:
#   cp .env.example .env
# ==============================================================================

# Server internal port (default 3000)
PORT=3000

# SQLite database file path inside container (mounts to ./data on host)
DATABASE_PATH=/app/data/bankpoker.db

# Host port for Nginx reverse proxy (default 80)
HTTP_PORT=80

# CRITICAL SECURITY REQUIREMENT:
# Set a strong, unique secret key for JWT signing & verification in production.
# Generate on Linux using: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_string_for_production_jwt_signing
