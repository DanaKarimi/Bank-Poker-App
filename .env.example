# BankPoker Server Configuration
# Copy this file to .env and set a secure random secret in production

JWT_SECRET=CHANGE_ME_TO_RANDOM_64_HEX
PORT=3000
NODE_ENV=production
DATABASE_PATH=./data/bankpoker.db
# Reverse proxy trust (number of hops in front of Node.js app, default 1 for Nginx)
TRUST_PROXY_HOPS=1
